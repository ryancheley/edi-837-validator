# Copy to .env and fill in. Never commit the real .env.
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=False
# Comma-separated hostnames (the domain Coolify serves this on).
ALLOWED_HOSTS=edi-validator.example.com
CSRF_TRUSTED_ORIGINS=https://edi-validator.example.com

# Postgres 18
POSTGRES_DB=edi
POSTGRES_USER=edi
POSTGRES_PASSWORD=change-me

# Companion-guide extraction (Anthropic / Claude)
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-4-8
# Only needed for user-scoped keys (sk-ant-usr-...); leave blank for
# workspace-scoped keys (sk-ant-api03-...).
ANTHROPIC_WORKSPACE_ID=

# Local only
WEB_PORT=8000
